# ── Proveedor de IA ─────────────────────────────────────────────────────────
# Valores: oci | local
LLM_PROVIDER=oci

# ── Fallback automático ───────────────────────────────────────────────────────
# Si el proveedor primario falla antes de emitir tokens, se reintenta con
# AI_FALLBACK_PROVIDER de forma transparente para el cliente.
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=local

# ── OCI Generative AI (primario) ─────────────────────────────────────────────
# OCI_COMPARTMENT_ID: OCI Console → Identity → Compartments → copiar el OCID
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxxxx
OCI_REGION=us-ashburn-1
OCI_MODEL_ID=meta.llama-3.3-70b-instruct
OCI_SERVICE_ENDPOINT=https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com
# local: api_key (lee ~/.oci/config) | servidor OCI: instance_principal
OCI_AUTH_TYPE=api_key
OCI_TIMEOUT_SECONDS=30

# ── llama.cpp local (fallback) ────────────────────────────────────────────────
# En Docker Compose el nombre del servicio es "llama-cpp"
# Para desarrollo fuera de Docker usar: http://127.0.0.1:8080/v1
LOCAL_LLM_BASE_URL=http://llama-cpp:8080/v1
LOCAL_LLM_MODEL=qwen3.5-4b

# ── Imágenes de recetas ───────────────────────────────────────────────────────
# web  → TheMealDB + Unsplash (gratuito, sin API key)
# none → desactiva la búsqueda (útil para tests)
IMAGE_SOURCE=web

# ── Base de datos ─────────────────────────────────────────────────────────────
# En Docker Compose la DB vive en el volumen /data
# Para desarrollo local usar: sqlite:///souschef.db
DATABASE_URL=sqlite:////data/souschef.db

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
